# Copy to .env for local development. NEVER commit a real .env file.

SERVICE_NAME=auth-service
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel_auth
REDIS_URL=redis://localhost:6379/0

# Generate a real random value for staging/production, e.g.: openssl rand -hex 32
# This MUST match JWT_SECRET_KEY in every other service's environment.
JWT_SECRET_KEY=local-dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MFA_ISSUER_NAME=Sentinel Chain

CORS_ORIGINS=["http://localhost:5173"]
